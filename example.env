# Most variables below are read by serverless.yml as ${env:NAME} with no
# fallback, so `bun run build` fails on the first missing one — it stops at
# variable resolution, before packaging, and names only that one variable. The
# pull-request workflow supplies placeholders; locally they have to be in .env.
# Packaging only needs them to exist; real values matter on deploy.
#
# The ones that do carry a default, and so may be left out: AGENTIC_BOT_ENABLED,
# ENABLE_SCHEDULING, WORKER_FAILURE_ALERT_EMAIL. SERVERLESS_ACCESS_KEY is read
# by the Serverless CLI itself rather than by the config.

# Telegram Bot
TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret

# Google APIs
COMMON_GOOGLE_API_KEY=your_google_api_key
GOOGLE_CX_TOKEN=your_google_custom_search_cx
YOUTUBE_TOKEN=your_youtube_api_key

# AI
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
OPENAI_API_KEY=your_openai_api_key
# Emergency global kill switch.
AGENTIC_BOT_ENABLED=true
# Used by owner-only /allowai and /disallowai commands.
BOT_OWNER_ID=your_numeric_telegram_user_id
# Telegram Login OIDC client ID issued by BotFather. Same value the UI uses;
# it is not a secret, but packaging still fails outright when it is unset.
TELEGRAM_OIDC_CLIENT_ID=your_numeric_telegram_oidc_client_id
# Signs the short-lived admin session; use at least 32 random characters.
ADMIN_SESSION_SECRET=your_random_admin_session_secret

# Weather
OPEN_WEATHER_MAP_TOKEN=your_openweathermap_token

# Currency
FIXER_API_KEY=your_fixer_api_key
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# GIFs (Giphy)
GIPHY_API_KEY=your_giphy_sdk_api_key

# Upstash Redis
UPSTASH_REDIS_URL=your_upstash_redis_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# Serverless
SERVERLESS_ACCESS_KEY=your_serverless_access_key
WORKER_FAILURE_ALERT_EMAIL=ddrrai@gmail.com

# Local development
ENABLE_SCHEDULING=false
