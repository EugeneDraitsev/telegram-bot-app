flowchart TB
  subgraph APP[" "]
    GHAPP@{ icon: "mdi:github", label: "telegram-bot-app", h: 36 }

    CRON1@{ icon: "logos:aws-eventbridge", label: "currency-scheduler<br/>Mon-Fri 9:00 / 17:00", h: 38 }

    BOT@{ icon: "logos:aws-lambda", label: "telegram-bot<br/>webhook ingress", h: 42 }

    subgraph QUEUES["FIFO job queues"]
      direction LR
      ACTQ@{ icon: "logos:aws-sqs", label: "activity jobs", h: 38 }
      REPLYQ@{ icon: "logos:aws-sqs", label: "reply jobs", h: 38 }
      AGENTQ@{ icon: "logos:aws-sqs", label: "agent jobs", h: 38 }
    end

    subgraph WORKERS["async workers"]
      direction LR
      ACT@{ icon: "logos:aws-lambda", label: "activity-worker<br/>stats / events / history", h: 42 }
      REPLY@{ icon: "logos:aws-lambda", label: "reply-worker<br/>commands", h: 42 }
      AGENT@{ icon: "logos:aws-lambda", label: "agent-worker<br/>reply gate + loop", h: 42 }
    end

    BCAST@{ icon: "logos:aws-lambda", label: "broadcast-stats", h: 42 }
    WSL@{ icon: "logos:aws-lambda", label: "websockets", h: 42 }
    IMG@{ icon: "logos:aws-lambda", label: "sharp-renderer<br/>SVG → PNG", h: 42 }

    WSS@{ icon: "logos:aws-api-gateway", label: "WebSocket API", h: 40 }
    DLQ@{ icon: "logos:aws-sqs", label: "3 worker DLQs", h: 38 }
    ALERT["CloudWatch + SNS<br/>email at 4+ failures"]:::alert
  end

  TG@{ icon: "logos:telegram", label: "Telegram", h: 46 }

  subgraph UIBOX[" "]
    GHUI@{ icon: "mdi:github", label: "telegram-bot-ui", h: 36 }
    NEXT@{ icon: "simple-icons:nextdotjs", label: "Next.js / Vercel", h: 40 }
  end

  subgraph THIRD["3rd party services"]
    GPT@{ icon: "simple-icons:openai", label: "GPT-5.6 Luna<br/>gate / loop / helpers", h: 38 }
    GEM@{ icon: "logos:google-gemini", label: "Gemini models<br/>fallbacks / images", h: 38 }
    APIS["OpenAI / Google Search / YouTube<br/>Weather / Tavily / Giphy"]:::ext
  end

  subgraph DATA["data stores"]
    direction LR
    REDIS@{ icon: "logos:redis", label: "Upstash Redis<br/>AI state / history / metrics", h: 40 }
    USERSTATS@{ icon: "logos:aws-dynamodb", label: "chat-user-statistics", h: 40 }
    EVENTS@{ icon: "logos:aws-dynamodb", label: "chat-events", h: 40 }
    CONNS@{ icon: "logos:aws-dynamodb", label: "websocket-connections", h: 40 }
  end

  GHAPP ~~~ BOT
  TG ~~~ GPT
  GPT ~~~ GEM
  GEM ~~~ APIS
  APIS ~~~ GHUI
  GHUI ~~~ NEXT

  CRON1 -->|"currency digest"| TG
  TG <==>|"webhook"| BOT

  BOT -->|"every message"| ACTQ --> ACT
  BOT -->|"registered cmds"| REPLYQ --> REPLY
  BOT -->|"AI chats: commands / fallback"| AGENTQ --> AGENT
  ACTQ & REPLYQ & AGENTQ -.->|"5 failed receives"| DLQ
  DLQ -.->|"> 3 visible"| ALERT

  REPLY -->|"reply"| TG
  AGENT -->|"reply"| TG
  CRON1 <--> APIS
  REPLY <--> APIS
  AGENT <--> APIS
  AGENT <-->|"gate + loop"| GPT
  AGENT <-->|"fallbacks / images"| GEM
  AGENT <-->|"state / history / metrics"| REDIS
  REPLY -->|"read metrics"| REDIS
  CRON1 <-.->|"currency PNG"| IMG
  REPLY <-.->|"stats / currency / metrics PNG"| IMG
  AGENT <-.->|"SVG → PNG"| IMG

  ACT -->|"one txn: event + count"| USERSTATS & EVENTS
  ACT -->|"AI history"| REDIS
  ACT -.->|"stats fanout"| BCAST

  BCAST --> USERSTATS & EVENTS & CONNS
  WSL --> USERSTATS & EVENTS & CONNS
  IMG -->|"read 24h stats"| EVENTS

  BCAST -.->|"push live stats"| WSS
  WSS <--> WSL

  NEXT <-->|"live stats"| WSS
  REPLY -.->|"signed stats link"| NEXT

  classDef ext fill:#059669,stroke:#064e3b,color:#ffffff,font-weight:bold
  classDef alert fill:#8b4a52,stroke:#63343a,color:#ffffff,font-weight:bold
  style QUEUES fill:transparent,stroke-dasharray:6 6
  style WORKERS fill:transparent,stroke-dasharray:6 6
  style THIRD fill:transparent,stroke-dasharray:6 6
  style DATA fill:transparent,stroke-dasharray:6 6
  style APP fill:transparent
  style UIBOX fill:transparent
