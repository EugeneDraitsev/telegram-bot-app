{
  "name": "chat-bot",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/EugeneDraitsev/telegram-bot-app"
  },
  "author": "Eugene Draitsev <ddrrai@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "sls offline start --stage local",
    "build": "bun run prepare:layers && sls package",
    "tsc": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "audit": "bun audit",
    "biome": "biome check ./src ./tools",
    "biome:fix": "biome check ./src ./tools --fix --unsafe",
    "logs": "sls logs -f telegram-bot -t",
    "diagram": "bun tools/render-diagrams.mts",
    "validate:deployment-config": "bun tools/validate-deployment-config.mts",
    "deploy": "bun run validate:deployment-config && bun run prepare:layers && sls deploy",
    "prepare:layers": "bun run prepare:sharp-layer && bun run prepare:ffmpeg-layer",
    "prepare:sharp-layer": "bun tools/prepare-sharp-layer.mts",
    "prepare:ffmpeg-layer": "bun tools/prepare-ffmpeg-layer.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "esbuild": "0.28.2",
    "serverless": "^4.41.1",
    "serverless-esbuild": "^1.57.2",
    "serverless-offline": "^14.8.0",
    "serverless-offline-sqs": "^9.0.1",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "src/*"
  ],
  "overrides": {
    "uuid": "11.1.1"
  }
}
